# ==============================================================================
# Dockerfile: Mandelbrok8s Worker
# Description: Multi-runtime container (Node.js 24 + Python/NumPy/Numba) 
#              for task polling and JIT fractal rendering.
# Author: Marc Bonet Bretto
# ==============================================================================

# Use official Python slim image on Debian (robust glibc for Numba wheels)
FROM python:3.11-slim

# Install system dependencies and Node.js 24 via NodeSource
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    build-essential \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && NODE_MAJOR=24 \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Set working directory inside the container for the worker application
WORKDIR /app/worker

# Copy package definition files and install Node.js production dependencies
COPY app/worker/package*.json ./
RUN npm ci

# Copy the compiled application code
COPY app/worker/dist/ ./dist/

# Copy the Python renderer script and its requirements file
COPY app/renderer/mandelbrok8s.py /app/renderer/mandelbrok8s.py
COPY app/renderer/mandelbrok8s-requirements /app/renderer/mandelbrok8s-requirements

# Install Python dependencies cleanly using precompiled wheels
RUN pip install --no-cache-dir -r /app/renderer/mandelbrok8s-requirements

# Set default runtime environment variables pointing to internal container paths
ENV PYTHON_BIN=python
ENV PYTHON_SCRIPT_PATH=/app/renderer/mandelbrok8s.py

# Expose default application port (runtime dynamically respects configuration from DB)
EXPOSE 8081

# Start the worker application from the compiled JavaScript output
CMD ["node", "dist/server.js"]
